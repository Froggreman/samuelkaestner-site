---
import Base from '../layouts/Base.astro';

const currentClass = {
  name: "New Testament Survey I",
  semester: "Spring 2026",
  description: "An introduction to the New Testament canon, with focus on the Gospels, Acts, and the historical-theological context of early Christianity.",
  papers: [
    { title: "What Is the New Testament?", type: "Unit Overview Paper", unit: "Unit 1", description: "An overview of the nature, formation, and theological significance of the New Testament canon." },
    { title: "What Are the Gospels?", type: "Discussion Post", unit: "Unit 2", description: "An examination of the Gospel genre, purpose, and the theological intent of the four Evangelists." },
  ],
};

const completedClasses = [
  { name: "Christian Ethics", semester: "Fall 2025", units: 7, description: "Foundations of Christian moral reasoning, applied ethics, and theological engagement with contemporary ethical issues." },
  { name: "Old Testament Survey II", semester: "Fall 2025", units: 8, description: "A survey of the poetic and prophetic literature of the Old Testament, with emphasis on canonical theology." },
  { name: "Old Testament Survey I", semester: "Summer 2025", units: 8, description: "An introduction to the Pentateuch and historical books, covering major themes of creation, covenant, and redemption." },
  { name: "Biblical Spirituality", semester: "Spring 2025", units: 8, description: "A theological and practical exploration of Christian spiritual formation rooted in Scripture." },
  { name: "Introduction to Hermeneutics", semester: "Spring 2025", units: 8, description: "Principles and methods for interpreting Scripture faithfully, with attention to genre, context, and application." },
];
---

<Base title="Seminary" description="Academic papers and course work from Midwestern Baptist Theological Seminary.">

  <section class="hero-section" style="padding: 3rem 1.5rem 2.5rem;">
    <div class="hero-inner">
      <p class="hero-label">Midwestern Baptist Theological Seminary</p>
      <h1 style="font-size: 2.4rem;">Seminary</h1>
      <p class="hero-tagline" style="margin-bottom: 0;">
        Master of Theological Studies (MTS) · Online · 2025–present
      </p>
    </div>
  </section>

  <div class="content-area">

    <div class="section-header">
      <h2>
        {currentClass.name}
        <span class="badge-current">Current · {currentClass.semester}</span>
      </h2>
    </div>

    <p style="color: var(--color-muted); font-size: 0.9rem; max-width: 580px; margin-bottom: 1.25rem;">{currentClass.description}</p>

    <div class="doc-list">
      {currentClass.papers.map((p) => (
        <div class="doc-item">
          <div class="doc-item-text">
            <h3>{p.title}</h3>
            <p>{p.description}</p>
          </div>
          <div class="doc-item-meta">{p.unit} · {p.type}</div>
        </div>
      ))}
    </div>

    <div class="section-header" style="margin-top: 3.5rem;">
      <h2>Completed Courses</h2>
      <div class="section-divider"></div>
      <p>5 courses · all units complete</p>
    </div>

    <div class="doc-list">
      {completedClasses.map((c) => (
        <div class="doc-item">
          <div class="doc-item-text">
            <h3>{c.name}</h3>
            <p>{c.description}</p>
          </div>
          <div class="doc-item-meta">{c.units} units · {c.semester}</div>
        </div>
      ))}
    </div>

  </div>

</Base>
