---
import Base from '../layouts/Base.astro';

const series = [
  { title: "Real", scripture: "1 John", weeks: 4, hook: "Everybody performs online. 1 John asks: is your faith real?", tags: ["Authenticity", "1 John"] },
  { title: "Rejoice", scripture: "Philippians", weeks: 4, hook: "Paul wrote the happiest letter in the Bible from prison. What does he know that we don't?", tags: ["Joy", "Philippians"] },
  { title: "Just Do It", scripture: "James", weeks: 4, hook: "You can say you believe anything. James wants to know: does your life agree?", tags: ["Faith & Works", "James"] },
  { title: "Stranger", scripture: "1 Peter", weeks: 4, hook: "Gen Z feels like they don't belong anywhere. God says that's exactly right — His people never did.", tags: ["Identity", "1 Peter"] },
  { title: "Third Way", scripture: "Phil 2 · John 8 · Rom 12", weeks: 4, hook: "Culture keeps giving you two options. Jesus keeps refusing both.", tags: ["Culture", "Ethics"] },
  { title: "The Greatest Story", scripture: "Genesis · John · Revelation", weeks: 4, hook: "You love stories with deep lore. God wrote the deepest one — and you're in it.", tags: ["Gospel", "Metanarrative"] },
  { title: "Christians in 2026", scripture: "Matthew 5 · Daniel 1 · Acts 2", weeks: 4, hook: "Everybody has a take. Christians are supposed to have something better.", tags: ["Culture", "Discipleship"] },
  { title: "Half Full", scripture: "Romans 8 · Psalm 139", weeks: 4, hook: "Not toxic positivity. Not despair. The biblical third option.", tags: ["Hope", "Sovereignty"] },
  { title: "Main Character", scripture: "Eph 2 · Psalm 139 · John 10", weeks: 4, hook: "Gen Z's biggest fear isn't failing. It's being irrelevant. Jesus has something to say about that.", tags: ["Identity", "Purpose"] },
  { title: "Timeless in 2026", scripture: "Hebrews 13 · Malachi 3 · Rev 21", weeks: 4, hook: "You're obsessed with bringing back 2016. But God never went out of style.", tags: ["Culture", "Nostalgia"] },
  { title: "Signal", scripture: "1 Timothy 2", weeks: 4, hook: "You text, DM, and post constantly — but when's the last time you actually talked to God?", tags: ["Prayer", "1 Timothy"] },
  { title: "Who Am I Really?", scripture: "Psalm 139 · 1 Cor 12 · 2 Cor 3", weeks: 4, hook: "You've let the algorithm tell you who you are. Scripture disagrees.", tags: ["Identity", "Social Media"] },
  { title: "Mind and Soul", scripture: "Romans 12 · 1 Peter 5 · James 1", weeks: 4, hook: "Mental health, Scripture, and what God actually says about your mind.", tags: ["Mental Health", "Renewal"] },
  { title: "Children's Stories Revisited", scripture: "Jonah · Luke 15 · John 6 · Gen 6–9", weeks: 4, hook: "You learned these as a kid. You missed the whole point.", tags: ["Gospel", "Narrative"] },
];

const standalones = [
  { title: "Mirror and the Face", scripture: "Psalm 139 · John 15", hook: "AI companions are mirrors. Jesus is a face. There's a difference." },
  { title: "It's Not a Situationship", scripture: "James 1 · Phil 3 · Matt 6", hook: "Vague spiritual identity is killing your faith. James has something to say about it." },
];
---

<Base title="Ministry" description="Youth teaching series and small group guides developed for middle and high school students.">

  <section class="hero-section" style="padding: 3rem 1.5rem 2.5rem;">
    <div class="hero-inner">
      <p class="hero-label">Crosspoint Church · McKinney, TX</p>
      <h1 style="font-size: 2.4rem;">Youth Ministry</h1>
      <p class="hero-tagline" style="margin-bottom: 0;">
        Teaching series and small group resources developed for middle and high school students.
        Each series includes full teaching outlines and a consolidated volunteer leader guide.
      </p>
    </div>
  </section>

  <div class="content-area">

    <div class="section-header">
      <h2>Teaching Series</h2>
      <div class="section-divider"></div>
      <p>{series.length} series complete</p>
    </div>

    <div class="series-grid">
      {series.map((s) => (
        <div class="series-card">
          <p class="series-meta">{s.weeks} weeks · {s.scripture}</p>
          <h3>"{s.title}"</h3>
          <p>{s.hook}</p>
          <div>
            {s.tags.map(tag => <span class="tag">{tag}</span>)}
          </div>
        </div>
      ))}
    </div>

    <div class="section-header" style="margin-top: 3.5rem;">
      <h2>Standalone Messages</h2>
      <div class="section-divider"></div>
    </div>

    <div class="doc-list">
      {standalones.map((m) => (
        <div class="doc-item">
          <div class="doc-item-text">
            <h3>"{m.title}"</h3>
            <p>{m.hook}</p>
            <p style="margin-top: 0.25rem; font-style: italic; font-size: 0.82rem;">{m.scripture}</p>
          </div>
          <div class="doc-item-meta">Standalone</div>
        </div>
      ))}
    </div>

    <div class="cta-box">
      <h3>Looking for the full resources?</h3>
      <p>Complete teaching outlines and small group leader guides are available on request. Reach out if you're a youth pastor or ministry leader who'd like to use any of these materials.</p>
    </div>

  </div>

</Base>
