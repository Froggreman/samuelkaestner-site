---
import Base from '../layouts/Base.astro';
---

<Base title="Samuel Kaestner" description="Youth minister and seminary student in McKinney, TX.">

  <!-- Dark hero -->
  <section class="hero-section">
    <div class="hero-inner">
      <p class="hero-label">Youth Minister · Seminary Student · Beekeeper</p>
      <h1>Samuel Kaestner</h1>
      <p class="hero-tagline">
        Serving students and families at Crosspoint Church in McKinney, TX.
        Pursuing a Master of Theological Studies at Midwestern Baptist Theological Seminary.
      </p>
      <div class="hero-divider"></div>
      <div class="mission-box">
        "To develop resilient believers who love and live for Jesus by leveraging every advance of our generation
        to point young hearts to the one true Life-Changer: Scripture fulfilled in Christ's cross and resurrection."
      </div>
    </div>
  </section>

  <!-- Cards -->
  <div class="content-area">
    <div class="section-header">
      <h2>Work</h2>
      <div class="section-divider"></div>
      <p>Teaching, preaching & academic writing</p>
    </div>

    <div class="card-grid">
      <a href="/ministry" style="text-decoration:none;">
        <div class="card">
          <div class="card-icon">📖</div>
          <p class="card-label">Youth Ministry</p>
          <h3>Teaching Series & Small Group Guides</h3>
          <p>Four-week series and volunteer leader guides developed for middle and high school students at Crosspoint Church.</p>
          <p class="card-arrow">View series →</p>
        </div>
      </a>

      <a href="/seminary" style="text-decoration:none;">
        <div class="card">
          <div class="card-icon">🎓</div>
          <p class="card-label">Seminary</p>
          <h3>Academic Papers & Course Notes</h3>
          <p>Written work completed at Midwestern Baptist Theological Seminary toward a Master of Theological Studies.</p>
          <p class="card-arrow">View coursework →</p>
        </div>
      </a>

      <a href="/about" style="text-decoration:none;">
        <div class="card">
          <div class="card-icon">✝️</div>
          <p class="card-label">About</p>
          <h3>Background & Ministry Philosophy</h3>
          <p>Ministry context, teaching philosophy, and the theological convictions that shape the work.</p>
          <p class="card-arrow">Learn more →</p>
        </div>
      </a>

      <a href="https://honeymckinney.com" target="_blank" rel="noopener" style="text-decoration:none;">
        <div class="card">
          <div class="card-icon">🐝</div>
          <p class="card-label">Beekeeping</p>
          <h3>Home Sweet Honey</h3>
          <p>Raw, unfiltered wildflower honey from McKinney, TX. Also available for swarm removal from your home or property.</p>
          <p class="card-arrow">Visit honeymckinney.com →</p>
        </div>
      </a>
    </div>
  </div>

</Base>
