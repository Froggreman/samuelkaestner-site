---
export interface Props {
  title: string;
  description?: string;
}

const { title, description = "Youth pastor, seminary student, and minister in McKinney, TX." } = Astro.props;
const siteTitle = "Samuel Kaestner";
const fullTitle = title === siteTitle ? title : `${title} — ${siteTitle}`;

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,700;1,400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="site-name">Samuel Kaestner</a>
        <nav>
          <a href="/" class={currentPath === "/" ? "active" : ""}>Home</a>
          <a href="/ministry" class={currentPath.startsWith("/ministry") ? "active" : ""}>Ministry</a>
          <a href="/seminary" class={currentPath.startsWith("/seminary") ? "active" : ""}>Seminary</a>
          <a href="/about" class={currentPath.startsWith("/about") ? "active" : ""}>About</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <p>Samuel Kaestner &nbsp;·&nbsp; Youth Minister, Crosspoint Church McKinney &nbsp;·&nbsp; MTS Student, Midwestern Baptist Theological Seminary</p>
    </footer>
  </body>
</html>
